# Connection parameters for the AWS RDS PostgreSQL database.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The Repository_Connection reads these five parameters (REQUIRED_PARAMS).

# RDS instance endpoint hostname (e.g. mydb.abc123.us-east-1.rds.amazonaws.com)
host=your-db-host.rds.amazonaws.com

# PostgreSQL port
port=5432

# Database name
dbname=ecommerce

# Database user
user=your_db_user

# Database password
password=your_db_password
